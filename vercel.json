{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend/",
      "framework": "vite"
    },
    "api": {
      "root": "./",
      "entrypoint": "app:app",
      "functions": {
        "app.py": {
          "maxDuration": 300,
          "excludeFiles": "{frontend/**,tests/**,docs/**,demo/**,tools/**,scripts/**,archive/**,prototypes/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/:prefix(health|spreadsheets|investigations|docs|openapi.json)/:path*",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
